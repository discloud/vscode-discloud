{
  "name": "discloud",
  "displayName": "Discloud",
  "description": "Somos uma plataforma de nuvem baseada em contêiner que nasceu com a vontade de oferecer hospedagem fácil, rápida, gratuita e de qualidade.",
  "publisher": "discloud",
  "version": "2.29.11",
  "engines": {
    "vscode": "^1.136.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/discloud/vscode-discloud.git"
  },
  "icon": "resources/icons/discloudlogo.png",
  "galleryBanner": {
    "color": "#0b0b0b",
    "theme": "dark"
  },
  "sponsor": {
    "url": "https://discloud.com/plans"
  },
  "keywords": [
    "cloud",
    "discloud",
    "discloud.app",
    "discloudbot",
    "discord",
    "host"
  ],
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:discloud.config",
    "onLanguage:discloudignore",
    "onStartupFinished",
    "workspaceContains:.discloudignore",
    "workspaceContains:discloud.config"
  ],
  "main": "out/extension.js",
  "l10n": "l10n",
  "contributes": {
    "authentication": [
      {
        "id": "discloud",
        "label": "Discloud API Token"
      }
    ],
    "commands": [
      {
        "command": "discloud.create.config",
        "icon": "$(gear)",
        "title": "%command.create.config%"
      },
      {
        "command": "discloud.commit",
        "icon": "$(git-commit)",
        "title": "%command.commit%"
      },
      {
        "command": "discloud.login",
        "icon": "$(log-in)",
        "title": "%command.login%"
      },
      {
        "command": "discloud.logout",
        "icon": "$(log-out)",
        "title": "%command.logout%"
      },
      {
        "command": "discloud.logs",
        "icon": "$(console)",
        "title": "%command.logs%"
      },
      {
        "command": "discloud.upload",
        "icon": "$(cloud-upload)",
        "title": "%command.upload%"
      },
      {
        "command": "discloud.system.locale.load",
        "title": "%command.system.locale.load%"
      },
      {
        "command": "discloud.apps.backup",
        "icon": "$(cloud-download)",
        "title": "%command.apps.backup%"
      },
      {
        "command": "discloud.apps.commit",
        "icon": "$(git-commit)",
        "title": "%command.apps.commit%"
      },
      {
        "command": "discloud.apps.copy.id",
        "icon": "$(clippy)",
        "title": "%command.apps.copy.id%"
      },
      {
        "command": "discloud.apps.delete",
        "icon": "$(trash)",
        "title": "%command.apps.delete%"
      },
      {
        "command": "discloud.apps.import",
        "icon": "$(cloud-download)",
        "title": "%command.apps.import%"
      },
      {
        "command": "discloud.apps.logs",
        "icon": "$(console)",
        "title": "%command.apps.logs%"
      },
      {
        "command": "discloud.apps.mods.add",
        "icon": "$(organization)",
        "title": "%command.apps.mods.add%"
      },
      {
        "command": "discloud.apps.mods.edit",
        "icon": "$(organization)",
        "title": "%command.apps.mods.edit%"
      },
      {
        "command": "discloud.apps.mods.rem",
        "icon": "$(organization)",
        "title": "%command.apps.mods.rem%"
      },
      {
        "command": "discloud.apps.profile.avatar",
        "title": "%command.apps.profile.avatar%"
      },
      {
        "command": "discloud.apps.profile.name",
        "title": "%command.apps.profile.name%"
      },
      {
        "command": "discloud.apps.ram",
        "icon": "$(circuit-board)",
        "title": "%command.apps.ram%"
      },
      {
        "command": "discloud.apps.refresh",
        "icon": "$(refresh)",
        "title": "%command.apps.refresh%"
      },
      {
        "command": "discloud.apps.restart",
        "icon": "$(debug-restart)",
        "title": "%command.apps.restart%"
      },
      {
        "command": "discloud.apps.show.avatar.instead.status.always",
        "icon": "$(account)",
        "title": "%show.avatar.instead.status.always.label%"
      },
      {
        "command": "discloud.apps.show.avatar.instead.status.never",
        "icon": "$(close)",
        "title": "%show.avatar.instead.status.never.label%"
      },
      {
        "command": "discloud.apps.show.avatar.instead.status.when.online",
        "icon": "$(cloud)",
        "title": "%show.avatar.instead.status.when.online.label%"
      },
      {
        "command": "discloud.apps.sort.by.none",
        "icon": "$(list-unordered)",
        "title": "%sort.none.label%"
      },
      {
        "command": "discloud.apps.sort.by.id.asc",
